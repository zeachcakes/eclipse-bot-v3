# Store text with LF line endings and check it out with LF on every platform.
* text=auto eol=lf

# Unix scripts must keep LF; Windows scripts need CRLF.
/gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no line-ending conversion or text diffs.
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Generated by mise; collapsed in GitHub diffs.
mise.lock linguist-generated=true
