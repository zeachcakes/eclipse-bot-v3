// For format details, see https://containers.dev/implementors/json_reference/
// Rationale for this configuration: docs/decisions/0001-local-dev-container.md
// and docs/decisions/0002-mise-toolchain-in-dev-container.md
{
	"name": "eclipse-bot-v3",

	// The service lives in docker-compose.yaml so that adding a database later is
	// a new service rather than a migration off the `build` property.
	"dockerComposeFile": "docker-compose.yaml",
	"service": "app",

	// Must match the bind mount target in docker-compose.yaml exactly. Compose
	// does not interpolate ${localWorkspaceFolderBasename}, so the repo name is
	// spelled out in both files; renaming the repo means editing both.
	"workspaceFolder": "/workspaces/eclipse-bot-v3",

	"features": {
		// Node is a dependency of the Claude Code feature, not a stack choice.
		// Pinned to lts because the feature otherwise auto-installs Node 18,
		// which is past end-of-life.
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
		// Manages project runtimes from mise.toml once a stack is chosen. Kept in
		// the image rather than on the host, so the Mac stays free of project
		// toolchains. Community-maintained, not from the devcontainers org.
		"ghcr.io/jsburckhardt/devcontainer-features/mise:1": {}
	},

	"containerEnv": {
		// The bind-mounted mise.toml is untrusted by default, and `mise install`
		// cannot answer the trust prompt without a TTY.
		"MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}",

		// Git refuses a repo owned by another user. Docker Desktop's file sharing
		// reports the workspace as uid 1000 at rest and as root while files in it
		// change, so no container user matches it all the time. Git reads
		// GIT_CONFIG_* as command-line config, which is allowed to set
		// safe.directory, and every process in the container inherits it.
		"GIT_CONFIG_COUNT": "1",
		"GIT_CONFIG_KEY_0": "safe.directory",
		"GIT_CONFIG_VALUE_0": "${containerWorkspaceFolder}"
	},

	// Runs on every start, including after a rebuild. A no-op when installed
	// tools already match mise.toml.
	"postStartCommand": "mise install",

	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh"
			},
			"extensions": [
				"anthropic.claude-code",
				"hverlin.mise-vscode"
			]
		}
	},

	"containerUser": "root",
	"remoteUser": "root"
}
