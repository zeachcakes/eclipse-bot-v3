# Shared local configuration for mise and Compose. Copy to root .env once.
# Keep real credentials in .env, which git ignores. Never overwrite an existing .env.

# Local PostgreSQL container. Never reuse development credentials elsewhere.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Discord application installed in the development guild.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Catalog migration role; used only by explicit database preparation tasks.
# Example URL: jdbc:postgresql://localhost:5432/eclipse_bot
CATALOG_DB_URL=
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=

# Catalog runtime role; separate from the migration role.
# Example URL: r2dbc:postgresql://localhost:5432/eclipse_bot
CATALOG_R2DBC_URL=
CATALOG_APP_DB_USER=
CATALOG_APP_DB_PASSWORD=
